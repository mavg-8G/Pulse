# Configuración NO secreta de Pulse (copiar a /opt/docker/pulse/.env)
PULSE_ENV=production
PULSE_BASE_URL=https://pulse.espectro.uk
PULSE_DB_PATH=/data/pulse.db
PULSE_LISTEN=:8080
# Red exclusiva Caddy–Pulse recomendada; crear/conectar antes según README.md.
# PULSE_PROXY_NETWORK=pulse_proxy
# Configurar SOLO la IP de Caddy/32 (o /128) tras inspeccionar su interfaz en esa red.
# Nunca usar el rango de una red compartida si otros contenedores no son confiables.
PULSE_TRUSTED_PROXY=172.18.0.0/16
TZ=America/Guayaquil
# Obligatorio con el docker-compose.yml de este repo: generar la pareja VAPID (README.md paso 7, PUSH.md).
PULSE_VAPID_PUBLIC_KEY=
PULSE_VAPID_SUBJECT=mailto:tu-correo@example.com
# Gmail (opcional; ver GMAIL.md). Sin client ID la conexión con Gmail queda desactivada.
PULSE_GOOGLE_CLIENT_ID=
# Cada cuánto se leen los correos (mínimo 5m en producción).
PULSE_GMAIL_POLL_INTERVAL=15m
# Tiempo real con Pub/Sub (opcional): tema y cuenta de servicio que firma los avisos.
PULSE_GMAIL_PUBSUB_TOPIC=
PULSE_GMAIL_PUBSUB_SA=
# PULSE_GEMINI_MODEL=gemini-2.5-flash
