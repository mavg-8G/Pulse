# Agregar al Caddyfile del contenedor de Caddy y recargar:
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
pulse.espectro.uk {
	encode zstd gzip
	reverse_proxy pulse:8080 {
		# Pulse decide la IP real del cliente; no reenviar identidades inventadas
		header_up -X-Forwarded-User
		header_up -X-Remote-User
	}
	# Las cabeceras de seguridad (CSP, HSTS, etc.) las pone el propio binario.
	log {
		output file /data/logs/pulse.access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
